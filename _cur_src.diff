+  [data-pattern="dots"] {
+    --lab-page-image: radial-gradient(var(--lab-page-line) 1px, transparent 1.1px);
+    --lab-page-size: 18px 18px;
+  }
+
+  [data-pattern="rules"] {
+    --lab-page-image: repeating-linear-gradient(to bottom,
+      var(--lab-page-line) 0, var(--lab-page-line) 1px,
+      transparent 1px, transparent 28px);
+    --lab-page-size: auto;
+  }
+
+  [data-pattern="diagonal"] {
+    --lab-page-image: repeating-linear-gradient(45deg,
+      var(--lab-page-line) 0, var(--lab-page-line) 1px,
+      transparent 1px, transparent 12px);
+    --lab-page-size: auto;
+  }
+
+  /* LA PAGE — un élément peint avec le fond des pages. `background-image` ne
+     touche pas `background-color` : la teinte choisie reste, le motif se pose
+     dessus. Et `var(--lab-page-image, none)` laisse intacte une page sans
+     motif — aucun attribut, aucun dessin. */
+  [class~="bg-slate-50"] {
+    background-image: var(--lab-page-image, none);
+    background-size: var(--lab-page-size, auto);
